# Banco de dados próprio do Controle de Estoque (Postgres, mesmo droplet do
# resto do sistema — mesmo padrão do Guardião). Formato:
# postgresql://usuario:senha@host:5432/estoque_db
ESTOQUE_DATABASE_URL=

# ID da planilha do Google Sheets do backlog de cancelamento (parte da URL
# entre /d/ e /edit). A planilha precisa estar compartilhada como
# "Qualquer pessoa com o link" (leitor) para o fetch público funcionar.
CANCELAMENTO_SHEET_ID=

# ID da planilha do Google Sheets do Controle de Saída (abas "Movimentação"
# e "Retorno e Reenviados"). Mesma exigência de compartilhamento acima.
SAIDA_SHEET_ID=
